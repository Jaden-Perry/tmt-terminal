# Copy to .env and fill in. Every key is free. The app runs without the optional ones
# and shows "N/A" with an explanation where that data would go.

# REQUIRED by SEC EDGAR: your name and email (it's how the SEC contacts heavy users).
SEC_USER_AGENT="Your Name your.email@school.edu"

# Recommended: free key at https://finnhub.io/register (60 calls/min).
# Adds news, recommendation trends, earnings surprises, peers.
FINNHUB_API_KEY=

# Recommended: free key at https://fred.stlouisfed.org/docs/api/api_key.html. Powers the Macro page.
FRED_API_KEY=

# Optional: free key at https://site.financialmodelingprep.com/developer/docs (250 calls/day).
# Used only as a fallback when Yahoo/Finnhub lack a field.
FMP_API_KEY=
FMP_DAILY_BUDGET=200

# Optional: the "Explain" AI summaries on big moves. Pay-as-you-go, with a hard cap below.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MONTHLY_CAP_USD=0.25
